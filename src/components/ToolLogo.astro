---
import ToolLogoReact from './ui/tool-logo';
import type { ToolLogoId } from '../data/portfolio';

interface Props {
  name: ToolLogoId;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
---
<ToolLogoReact name={name} size={size} className={className} />
