---
import type { CollectionEntry } from 'astro:content';
import Glyph from '../Glyph.astro';
import { projectFilterGroups, projectGroupMap } from '../../data/portfolio';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---
<section id="projects" class="page-sec projects-sec" aria-labelledby="projects-title" data-projects-gallery>
  <div class="wrap">
    <div class="projects-head">
      <div>
        <div class="sec-label">מקרי בוחן · 6 פרויקטים</div>
        <h2 id="projects-title" class="sec-h2" data-rise>
          מערכות שבניתי — <em>הבעיה, הארכיטקטורה והקוד</em>
        </h2>
        <p class="sec-sub" data-rise>
          כל כרטיס מוביל למקרה בוחן מלא עם פירוט האתגר הטכני, מבנה הנתונים ומה נבדק בפועל.
        </p>
      </div>

      <div class="projects-filters" role="group" aria-label="סינון פרויקטים לפי תחום">
        {projectFilterGroups.map((group, idx) => (
          <button
            type="button"
            class="filter-pill"
            aria-pressed={idx === 0 ? 'true' : 'false'}
            data-proj-filter={group.id}
          >
            {group.label}
          </button>
        ))}
      </div>
    </div>

    <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>

    <div class="res-grid">
      {projects.map((project) => {
        const { data } = project;
        const group = projectGroupMap[project.id] ?? 'ai-mcp';
        return (
          <article
            class:list={['res-card', 'accent-' + data.accent]}
            data-proj-card
            data-proj-group={group}
            data-rise
          >
            <a class="res-card-link" href={`/projects/${project.id}/`}>
              <div class="res-thumb">
                {data.media ? (
                  <div class="res-art res-art-media">
                    <img
                      src={data.media.src}
                      alt={data.media.alt}
                      width={data.media.width}
                      height={data.media.height}
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="res-cover-tag">צילום ממשק מקורי</span>
                  </div>
                ) : project.id === 'gpt-desktop-agent' ? (
                  <div class="res-art res-art-bridge" aria-hidden="true">
                    <div class="art-win">
                      <div class="art-dots"><i></i><i></i><i></i></div>
                      <span class="art-kicker" dir="ltr">MCP · Windows + Chrome</span>
                      <div class="art-bridge-img">
                        <img
                          src="/media/desktop-bridge.webp"
                          alt=""
                          width={300}
                          height={98}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="art-trace" dir="ltr">
                        <span>AI Agent</span>
                        <em>→</em>
                        <span>MCP Server</span>
                        <em>→</em>
                        <span>Bridge</span>
                      </div>
                    </div>
                    <span class="res-cover-tag">צילום תוסף + ארכיטקטורה</span>
                  </div>
                ) : project.id === 'whatsapp-sales-agent' ? (
                  <div class="res-art res-art-chart" aria-hidden="true">
                    <div class="art-pipeline-card" dir="ltr">
                      <span class="art-kicker">Node.js · Notion CRM · Gemma</span>
                      <svg class="art-svg-flow" viewBox="0 0 240 88" width="240" height="88">
                        <line x1="0" x2="240" y1="22" y2="22" stroke="var(--border)" />
                        <line x1="0" x2="240" y1="44" y2="44" stroke="var(--border)" />
                        <line x1="0" x2="240" y1="66" y2="66" stroke="var(--border)" />
                        <path d="M12 68 C48 64, 62 32, 98 38 S154 14, 186 24 214 14, 230 16" fill="none" stroke="var(--gold-bright)" stroke-width="2" />
                        <circle cx="12" cy="68" r="4" fill="var(--primary)" />
                        <circle cx="98" cy="38" r="4" fill="var(--gold-bright)" />
                        <circle cx="186" cy="24" r="4" fill="var(--chart-5)" />
                        <circle cx="230" cy="16" r="4" fill="var(--good)" />
                      </svg>
                      <div class="art-trace">
                        <span>WhatsApp</span>
                        <em>→</em>
                        <span>Gemma</span>
                        <em>→</em>
                        <span>Notion</span>
                      </div>
                    </div>
                    <span class="res-cover-tag">המחשה ארכיטקטונית</span>
                  </div>
                ) : (
                  <div class="res-art res-art-paper" aria-hidden="true">
                    <div class="art-sheet">
                      <small dir="ltr">Next.js · MCP · TTS · FFmpeg</small>
                      <b dir="ltr">Course Index → Lesson Studio</b>
                      <div class="art-bars">
                        <span class="ab-1"></span>
                        <span class="ab-2"></span>
                        <span class="ab-3"></span>
                        <span class="ab-4"></span>
                        <span class="ab-5"></span>
                        <span class="ab-6"></span>
                      </div>
                      <div class="art-trace" dir="ltr">
                        <span>Index</span>
                        <em>→</em>
                        <span>MCP</span>
                        <em>→</em>
                        <span>MP4</span>
                      </div>
                    </div>
                    <span class="res-cover-tag">המחשה ארכיטקטונית</span>
                  </div>
                )}
              </div>

              <div class="res-cap">
                <div class="res-meta-row">
                  <span class="res-cat">{data.category}</span>
                  <span class="res-status">{data.status}</span>
                </div>
                <h3 class="res-title"><bdi dir="ltr">{data.title}</bdi></h3>
                <p class="res-problem">{data.problem}</p>
                <p class="res-overview">{data.overview}</p>
                <ul class="res-tags" aria-label="טכנולוגיות">
                  {data.techStack.slice(0, 4).map((t) => (
                    <li dir="ltr">{t}</li>
                  ))}
                </ul>
                <div class="res-foot">
                  <span>למקרה הבוחן המלא</span>
                  <Glyph name="arrow-left" size={15} class="res-arrow" />
                </div>
              </div>
            </a>

            {data.repository && (
              <a
                class="res-repo-pill"
                href={data.repository}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`קוד מקור ב־GitHub עבור ${data.shortTitle}`}
                dir="ltr"
              >
                <Glyph name="github" size={13} />
                <span>GitHub</span>
              </a>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>
