---
import { siteConfig } from '../../config';
import { ongoingServices } from '../../data/portfolio';
import Glyph from '../Glyph.astro';

const monitoringSubject = 'בדיקת התאמה לריטיינר ניטור ותפעול שוטף';
const monitoringMailto = `mailto:${siteConfig.email}?subject=${encodeURIComponent(monitoringSubject)}`;

const monitoringScope = [
  'ניטור יזום (Watchdog) של אוטומציות, Webhooks, טפסים וסנכרוני CRM — כולל זיהוי כשלים שקטים.',
  'בדיקה ותחזוקה שוטפת של אתרים, חנויות איקומרס, מלאי, תקינות SEO טכני ומערכות פרסום לסושיאל.',
  'טיפול מהיר בחריגים, תיעוד מסודר של כל שינוי ודיווח חודשי שניתן להעביר ישירות ללקוח הקצה.',
  'ניצול שוטף של חודשים שקטים לטובת שיפורי מהירות, SEO ואוטומציות מתוך תור המשימות המוסכם.',
] as const;

const monitoringParams = [
  'מערכות ותהליכים מכוסים',
  'תכולה ותור משימות חודשי ברור',
  'זמני תגובה (SLA) בימי עסקים',
  'הרשאות, תיעוד ונוהל הסלמה',
] as const;
---
<section id="services" class="page-sec services-sec" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services-head">
      <div class="sec-label">מה נכנס תחת הריטיינר</div>
      <h2 id="services-title" class="sec-h2" data-rise>
        שישה תחומי תפעול ותחזוקה — <em>בלי לרדוף אחרי 5 ספקים</em>
      </h2>
      <p class="sec-sub" data-rise>
        אפשר לבחור תחום אחד ממוקד או לשלב כמה תחומים תחת אותו ריטיינר חודשי — לעסק שלכם ישירות, או כזרוע ביצוע מאחורי הקלעים עבור לקוחות הסוכנות.
      </p>
    </div>

    <div class="services-layout">
      <div class="ongoing-grid">
        {ongoingServices.map((srv) => (
          <article id={`service-${srv.id}`} class="service-card ongoing-card" data-rise>
            <div class="service-card-top">
              <span class="service-ic"><Glyph name={srv.icon} size={20} /></span>
              <span class="service-badge" dir="ltr">{srv.kicker}</span>
            </div>
            <h3>{srv.title}</h3>
            <p class="service-desc">{srv.description}</p>
            <ul class="service-points">
              {srv.points.map((pt) => (
                <li>
                  <Glyph name="check" size={14} stroke={2.2} />
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
            <div class="service-foot">
              <span class="service-ideal">מתאים ל: <strong>{srv.idealFor}</strong></span>
              <a class="service-ref-link" href="#retainers">
                <span>למסלולים</span>
                <Glyph name="arrow-left" size={14} />
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Featured Watchdog & Managed Operations Spotlight -->
      <article id="services-monitoring" class="service-card service-monitoring" data-rise>
        <div class="monitoring-grid">
          <div class="monitoring-main">
            <div class="service-card-top">
              <span class="service-ic service-ic-gold"><Glyph name="shield" size={20} /></span>
              <span class="service-badge service-badge-gold">הלב של הריטיינר · ניטור אקטיבי + מרווח רווח לשותפים</span>
            </div>

            <h3>ניטור, פיקוח ותפעול מערכות מאחורי הקלעים</h3>

            <p class="service-desc monitoring-audience">
              מיועד לעסקים שרוצים שהמערכות והשיווק יעבדו בלי הפתעות, ולחברות אינטגרציה, <bdi dir="ltr">CRM</bdi> וסוכנויות דיגיטל שרוצות להפוך את תחזוקת הלקוחות הקיימים ממטרד תפעולי להכנסה חודשית קבועה ורווחית ב־<bdi dir="ltr">White-label</bdi>.
            </p>

            <ul class="monitoring-list">
              {monitoringScope.map((point) => (
                <li>
                  <span class="monitoring-check" aria-hidden="true">
                    <Glyph name="check" size={14} stroke={2.3} />
                  </span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>

          <aside class="monitoring-side" aria-label="מסגרת פיילוט ושקיפות השירות">
            <div class="monitoring-pilot-box">
              <span class="monitoring-kicker">קליטה מסודרת (שלב 0) ללא סיכון</span>
              <p>
                לפני שנכנסים לריטיינר שוטף מגדירים יחד תכולה ברורה ובודקים התאמה בפיילוט ממוקד:
              </p>
              <ul class="monitoring-params">
                {monitoringParams.map((param) => (
                  <li>{param}</li>
                ))}
              </ul>
              <p class="monitoring-boundary">
                <strong>גבולות היקף בשקיפות מלאה:</strong> הפעילות מתבצעת בשעות עסקים א׳–ה׳ <bdi dir="ltr">09:00–18:00</bdi> ובהיקף שמוסכם מראש בלבד — השירות אינו מוקד <bdi dir="ltr">24/7</bdi> ואינו מיועד למערכות קריטיות/בטיחותיות.
              </p>
            </div>

            <div class="monitoring-cta-wrap">
              <a class="button primary monitoring-cta" href={monitoringMailto} data-monitoring-mailto>
                <Glyph name="mail" size={16} />
                <span>לבדיקת התאמה לריטיינר או פיילוט</span>
                <Glyph name="arrow-left" size={15} />
              </a>
              <span class="monitoring-cta-hint">
                או ישירות בטלפון / וואטסאפ: <strong dir="ltr">{siteConfig.phone}</strong>
              </span>
            </div>
          </aside>
        </div>
      </article>
    </div>
  </div>
</section>
