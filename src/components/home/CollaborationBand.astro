---
import { siteConfig } from '../../config';
import { collaborationTracks } from '../../data/portfolio';
import Glyph from '../Glyph.astro';

const defaultTrack = collaborationTracks[0];
const initialMailto = `mailto:${siteConfig.email}?subject=${encodeURIComponent(defaultTrack.mailSubject)}`;

const coreSteps = [
  {
    title: 'מגדירים משימה ראשונה',
    detail: 'מסכימים על התוצאה, המערכות שצריך לחבר וקריטריוני הקבלה לפני שמתחילים.',
  },
  {
    title: 'בונים ובודקים מקצה לקצה',
    detail: 'אני מחבר את המערכות, בודק תרחישים אמיתיים ומתעד מה מפעיל את התהליך, מה הוא מחזיר ואיך מטפלים בחריגים.',
  },
  {
    title: 'ממשיכים לפי הצורך',
    detail: 'משימה ראשונה יכולה להפוך לשיתוף פעולה קבוע בפרויקטים נוספים ותחת המותג שלכם.',
  },
];
---
<section id="collaboration" class="page-sec collab-sec" aria-labelledby="collab-title" data-collab-band>
  <span class="collab-glow" aria-hidden="true"></span>

  <div class="wrap split-layout">
    <div class="sec-label sec-label-dark" dir="ltr">White-label</div>

    <div class="collab-content">
      <h2 id="collab-title" class="collab-big" data-rise>
        <span>עבודה עם סוכנויות</span> וצוותי תוכנה
      </h2>
      <p class="collab-intro" data-rise>
        אתם מנהלים את הקשר עם לקוח הקצה. אני מבצע את המשימה הטכנית לפי האפיון שלכם, עם בדיקות ותיעוד למסירה. אפשר לעבוד תחת המותג שלכם.
      </p>

      <ul class="collab-list" data-check-list>
        {coreSteps.map((step) => (
          <li data-rise>
            <svg class="collab-check" width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12.5l4.2 4.2L19 7" />
            </svg>
            <div>
              <strong>{step.title}</strong>
              <p>{step.detail}</p>
            </div>
          </li>
        ))}
        <li class="collab-addon" data-rise>
          <button
            type="button"
            class="collab-addon-btn"
            aria-expanded="false"
            aria-controls="collab-addon-body"
            data-addon-btn
          >
            <span class="plus-icon" data-addon-icon>
              <Glyph name="plus" size={16} />
            </span>
            <span>איך נראית מסירה מסודרת תחת המותג שלכם?</span>
          </button>
          <div id="collab-addon-body" class="collapse-grid" data-addon-panel>
            <div>
              <p>
                כל משימה נמסרת עם תיעוד קצר וברור: טריגרים וחיבורי API, רשימת הרשאות ומשתני סביבה, תרחישי בדיקה שהורצו והסבר על טיפול בחריגים — כדי שהצוות שלכם יישאר בשליטה מלאה מול הלקוח.
              </p>
            </div>
          </div>
        </li>
      </ul>

      <div class="track-card" data-track-selector data-tracks={JSON.stringify(collaborationTracks)} data-email={siteConfig.email} data-rise>
        <div class="track-card-head">
          <div>
            <span class="track-kicker">בחרו מסגרת עבודה להשוואה</span>
            <h3 data-track-title>{defaultTrack.label}</h3>
          </div>
          <div class="track-tabs" role="tablist" aria-label="מסלולי שיתוף פעולה">
            {collaborationTracks.map((track, idx) => (
              <button
                type="button"
                role="tab"
                class="track-tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
                data-track-id={track.id}
              >
                {track.label}
              </button>
            ))}
          </div>
        </div>

        <p class="track-sub" data-track-sub>{defaultTrack.subtitle}</p>
        <p class="track-focus" data-track-focus>{defaultTrack.focus}</p>

        <ul class="track-deliverables" data-track-deliverables>
          {defaultTrack.deliverables.map((item) => (
            <li>
              <Glyph name="check" size={14} stroke={2.2} />
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="track-foot">
          <p class="track-handoff" data-track-handoff>{defaultTrack.handoff}</p>
          <a class="button track-cta" href={initialMailto} data-track-mailto>
            <Glyph name="mail" size={15} />
            <span>פתיחת פנייה במייל בנושא זה</span>
            <Glyph name="arrow-left" size={14} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
