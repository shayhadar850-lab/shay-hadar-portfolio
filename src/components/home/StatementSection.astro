---
interface StatementWord {
  word: string;
  gold?: boolean;
}

const statementWords: StatementWord[] = [
  { word: 'מערכות,' },
  { word: 'אתרים' },
  { word: 'ואוטומציות' },
  { word: 'לא' },
  { word: 'נגמרים' },
  { word: 'ביום' },
  { word: 'ההשקה.' },
  { word: 'ההבדל' },
  { word: 'האמיתי' },
  { word: 'הוא' },
  { word: 'שקט', gold: true },
  { word: 'תפעולי', gold: true },
  { word: '—' },
  { word: 'ניטור' },
  { word: 'תקלות,' },
  { word: 'תחזוקה' },
  { word: 'שוטפת' },
  { word: 'ושיפור' },
  { word: 'מתמיד' },
  { word: 'תחת' },
  { word: 'ריטיינר' },
  { word: 'חודשי' },
  { word: 'אחד.' },
];

const pillars = [
  {
    figure: '3',
    label: 'מסלולי ריטיינר שקופים לעסקים ולסוכנויות — עם חודש ראשון ללא התחייבות.',
  },
  {
    figure: '6',
    label: 'תחומי תפעול תחת קורת גג אחת: אוטומציות ו־CRM, אתרים, איקומרס, SEO, סושיאל ו־AI.',
  },
  {
    figure: 'WL',
    label: 'זרוע ביצוע שוטפת לסוכנויות ב־White-label או ישירות לעסקים וחנויות אונליין.',
  },
] as const;
---
<section id="approach" class="page-sec statement-sec" aria-labelledby="statement-label">
  <div class="wrap split-layout">
    <div id="statement-label" class="sec-label">הגישה</div>
    <div class="statement-body">
      <p class="statement-text" data-ink-statement>
        {statementWords.map((item, idx) => (
          <>
            <span class:list={['ink-word', { 'text-gold': item.gold }]} data-ink-word>
              {item.word}
            </span>
            {idx < statementWords.length - 1 ? ' ' : ''}
          </>
        ))}
      </p>

      <div class="stat-tiles" data-stat-tiles>
        {pillars.map((item) => (
          <div class="stat-tile" data-rise>
            <span class="stat-rule" data-stat-rule aria-hidden="true"></span>
            <b dir="ltr">{item.figure}</b>
            <p>{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
