---
interface StatementWord {
  word: string;
  gold?: boolean;
}

const statementWords: StatementWord[] = [
  { word: 'אינטגרציה' },
  { word: 'טובה' },
  { word: 'לא' },
  { word: 'נגמרת' },
  { word: 'בחיבור' },
  { word: 'הראשון.' },
  { word: 'ההבדל' },
  { word: 'האמיתי' },
  { word: 'הוא' },
  { word: 'אמינות', gold: true },
  { word: 'ובקרת', gold: true },
  { word: 'איכות', gold: true },
  { word: '—' },
  { word: 'זיהוי' },
  { word: 'תקלות' },
  { word: 'שקטות,' },
  { word: 'אימות' },
  { word: 'מול' },
  { word: 'מערכת' },
  { word: 'היעד' },
  { word: 'ותיעוד' },
  { word: 'ברור' },
  { word: 'לצוות.' },
];

const pillars = [
  {
    figure: '3',
    label: 'תחומי ליבה: אוטומציות ואינטגרציות, כלים פנימיים ושילוב AI, וניטור ובקרת איכות.',
  },
  {
    figure: '6',
    label: 'מערכות מתועדות בתיק העבודות — עם ארכיטקטורה, בדיקות וצילומי מסך מהרצה מקומית.',
  },
  {
    figure: '28+',
    label: 'כלים ומודלים בחיבור יומיומי: OpenAI, Claude, Gemini, SAP, Priority, Make/n8n, ענן ו־MCP.',
  },
] as const;
---
<section id="approach" class="page-sec statement-sec" aria-labelledby="statement-label">
  <div class="wrap split-layout">
    <div id="statement-label" class="sec-label">הגישה ההנדסית</div>
    <div class="statement-body">
      <p class="statement-text" data-ink-statement>
        {statementWords.map((item, idx) => (
          <>
            <span class:list={['ink-word', { 'text-gold': item.gold }]} data-ink-word>
              {item.word}
            </span>
            {idx < statementWords.length - 1 ? ' ' : ''}
          </>
        ))}
      </p>

      <div class="stat-tiles" data-stat-tiles>
        {pillars.map((item) => (
          <div class="stat-tile" data-rise>
            <span class="stat-rule" data-stat-rule aria-hidden="true"></span>
            <b dir="ltr">{item.figure}</b>
            <p>{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
