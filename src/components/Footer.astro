---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
import { he } from '../i18n/he';
import BrandMark from './BrandMark.astro';
import Glyph from './Glyph.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const wordmarkChars = Array.from('SHAY HADAR');
const mailHref = `mailto:${siteConfig.email}?subject=${encodeURIComponent(siteConfig.defaultMailSubject)}`;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <a class="brand" href="/">
          <BrandMark size={30} />
          <span class="brand-text">
            <span class="brand-name">{he.brand}</span>
            <small>{he.role}</small>
          </span>
        </a>
        <p class="footer-bio">
          עוזר לארגונים, לחברות טכנולוגיה ולצוותי תפעול לחבר בין מערכות, להפוך עבודה ידנית לאוטומטית, לבנות כלים פנימיים ולתחזק אינטגרציות קיימות עם ניטור ובקרות.
        </p>
      </div>

      <div class="footer-col">
        <b>מקרי בוחן</b>
        {projects.map((p) => (
          <a href={`/projects/${p.id}/`}>
            <bdi dir="ltr">{p.data.shortTitle}</bdi>
          </a>
        ))}
      </div>

      <div class="footer-col">
        <b>באתר</b>
        <a href="/#featured-projects">פרויקטים נבחרים</a>
        <a href="/#capabilities">יכולות והתמחויות</a>
        <a href="/#tools">כלים וטכנולוגיות</a>
        <a href="/#projects">כל הפרויקטים (6 מערכות)</a>
        <a href="/#collaboration">איך עובדים יחד</a>
        <a href="/#packages">אפשרויות עבודה ומסגרות</a>
        <a href="/#faq">שאלות נפוצות</a>
      </div>

      <div class="footer-col">
        <b>קשר ישיר</b>
        <a href={mailHref} dir="ltr">{siteConfig.email}</a>
        <a href={`tel:${siteConfig.phone.replace(/-/g, '')}`} dir="ltr">{siteConfig.phone}</a>
        <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" dir="ltr">GitHub</a>
        <a href="/contact/">עמוד יצירת קשר</a>
      </div>
    </div>

    <div class="footer-bar">
      <div class="footer-meta">
        <span>© שי הדר</span>
        <span aria-hidden="true">·</span>
        <span dir="ltr">Automation · Integrations · Internal Tools · AI &amp; MCP</span>
      </div>
      <div class="footer-social">
        <a href={mailHref} aria-label="שליחת אימייל לשי הדר">
          <Glyph name="mail" size={15} />
        </a>
        <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub של שי הדר">
          <Glyph name="github" size={15} />
        </a>
      </div>
    </div>

    <p class="footer-note">
      שקיפות: ההדגמות האינטראקטיביות בדף הן סימולציות מקומיות להמחשת ארכיטקטורה וזרימת עבודה ואינן שולחות מידע לשירותים חיצוניים. צילומי המסך באתר מבוססים על נתוני דוגמה מקומיים בלבד.
    </p>
  </div>

  <div class="footer-bigmark" dir="ltr" aria-hidden="true" data-bigmark>
    {wordmarkChars.map((ch) => (
      <span class="bigmark-ch">{ch === ' ' ? '\u00A0' : ch}</span>
    ))}
  </div>
</footer>
