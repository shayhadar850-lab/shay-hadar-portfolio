---
import { he } from '../i18n/he';
---
<header class="site-header">
  <div class="wrap header-shell">
    <a href="/" class="brand">
      <span class="brand-mark" dir="ltr" aria-hidden="true">SH</span>
      <span>{he.brand}<small dir="ltr">Automation & Integrations</small></span>
    </a>
    <nav aria-label={he.navigation}>
      <a href="/#projects">{he.projects}</a>
      <a href="/#capabilities">{he.capabilities}</a>
      <a href="/#collaboration">{he.collaboration}</a>
    </nav>
    <a class="button nav-contact" href="/#contact">{he.contact}</a>
  </div>
</header>

<style>
  .nav-contact {
    min-inline-size: max-content;
    padding-inline: 17px;
    background: var(--sidebar);
    border-color: var(--sidebar-border);
    white-space: nowrap;
  }

  @media (max-width: 360px) {
    .nav-contact { padding-inline: 12px; font-size: .79rem; }
    .header-shell .brand { gap: 6px; }
    .header-shell .brand small { font-size: .56rem; }
  }
</style>
