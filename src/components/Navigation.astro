---
import { he } from '../i18n/he';
---
<header class="site-header">
  <div class="wrap header-shell">
    <a href="/" class="brand">
      <span class="brand-mark" dir="ltr" aria-hidden="true">SH</span>
      <span>{he.brand}<small dir="ltr">Automation & Integrations</small></span>
    </a>
    <nav aria-label={he.navigation}>
      <a href="/#projects">{he.projects}</a>
      <a href="/#capabilities">{he.capabilities}</a>
      <a href="/#collaboration">{he.collaboration}</a>
    </nav>
    <a class="nav-contact" href="/#contact">
      <span>{he.contact}</span>
      <span class="nav-contact-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M15 10H5m0 0 4.5-4.5M5 10l4.5 4.5" />
        </svg>
      </span>
    </a>
  </div>
</header>

<style>
  .nav-contact {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 9px;
    inline-size: max-content;
    min-block-size: 44px;
    padding-block: 4px;
    padding-inline: 13px 5px;
    border: 1px solid #ebdfff;
    border-radius: 999px;
    background: linear-gradient(155deg, #eee2ff, var(--highlight) 85%);
    box-shadow: inset 0 1px 0 #fff8, 0 3px 12px #09061b5c;
    color: #271a4a;
    font-size: .85rem;
    font-weight: 750;
    line-height: 1.2;
    white-space: nowrap;
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }

  .nav-contact-icon {
    display: grid;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    border-radius: 50%;
    background: #32235b;
    color: #f5ebff;
    transition: background-color .2s ease;
  }

  .nav-contact-icon svg {
    transition: transform .22s cubic-bezier(.2,.7,.3,1);
  }

  .nav-contact:is(:hover, :focus-visible) {
    border-color: #fff5ff;
    box-shadow: inset 0 1px 0 #fffc, 0 4px 17px #ab8dff59;
  }

  .nav-contact:is(:hover, :focus-visible) .nav-contact-icon {
    background: #4f3585;
  }

  @media (max-width: 360px) {
    .nav-contact {
      gap: 6px;
      padding-inline: 9px 4px;
      font-size: .79rem;
    }

    .nav-contact-icon {
      inline-size: 28px;
      block-size: 28px;
    }

    .header-shell .brand {
      gap: 6px;
    }

    .header-shell .brand small {
      font-size: .56rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-contact:is(:hover, :focus-visible) .nav-contact-icon svg {
      transform: translateX(-2px);
    }

    .nav-contact:active {
      transform: translateY(1px);
    }
  }
</style>
