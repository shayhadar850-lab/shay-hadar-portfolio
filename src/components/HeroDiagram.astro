---
import Glyph from './Glyph.astro';

const paths = [
  'M86 99V127Q86 146 104 146H183',
  'M454 99V127Q454 146 436 146H357',
  'M86 243V215Q86 196 104 196H183',
  'M454 243V215Q454 196 436 196H357',
];
---
<figure class="hero-visual" aria-label="המחשה של תהליך המחבר ערוצי שיווק, מערכות CRM, מודלי AI ומשימות יומיות">
  <div class="hero-plane" dir="ltr" aria-hidden="true">
    <div class="hero-canvas">
      <span class="canvas-label">Workflow overview</span>
      <svg class="hero-wires" viewBox="0 0 540 344" preserveAspectRatio="none">
        {paths.map((d) => <path d={d} pathLength="100" class="workflow-rail" />)}
        {paths.map((d, index) => <path d={d} pathLength="100" class:list={['workflow-signal', 'signal-' + index]} />)}
      </svg>
      <div class="hero-node hero-node-ai"><Glyph name="spark" /><span>AI models</span></div>
      <div class="hero-node hero-node-chrome"><Glyph name="message" /><span>Social & web</span></div>
      <div class="hero-node hero-node-core"><Glyph name="nodes" size={29} /><span>Automation</span><small>n8n · Make · APIs</small></div>
      <div class="hero-node hero-node-crm"><Glyph name="database" /><span>CRM & data</span></div>
      <div class="hero-node hero-node-events"><Glyph name="calendar" /><span>Daily tasks</span></div>
    </div>
  </div>
  <figcaption>דוגמה לחיבור מערכות בתהליך אחד</figcaption>
</figure>
