---
import { siteConfig } from '../config';
interface Props { heading?: 'h1' | 'h2'; }
const { heading: Heading = 'h2' } = Astro.props;
const email = 'mailto:' + siteConfig.email + '?subject=' + encodeURIComponent('שיתוף פעולה טכנולוגי');
---
<section id="contact" class="contact-panel" aria-labelledby="contact-title">
  <div>
    <p class="eyebrow">יצירת קשר</p>
    <Heading id="contact-title">יש לכם משימה טכנית על השולחן?</Heading>
    <p>שלחו לי בקצרה מה צריך לבנות, אילו מערכות מעורבות ומה חשוב לכם במסירה.</p>
  </div>
  <div class="contact-actions">
    <a class="button primary" href={email}>שליחת אימייל <span class="arrow-diagonal" aria-hidden="true"></span></a>
    <a href={email} class="email-link" dir="ltr">{siteConfig.email}</a>
    <a href={siteConfig.github} class="email-link" dir="ltr">GitHub <span class="arrow-diagonal arrow-out" aria-hidden="true"></span></a>
  </div>
</section>
