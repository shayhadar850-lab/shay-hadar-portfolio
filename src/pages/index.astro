---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import Glyph from '../components/Glyph.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Architecture from '../components/Architecture.astro';
import Contact from '../components/Contact.astro';
import WorkflowExample from '../components/WorkflowExample.astro';
import { siteConfig } from '../config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const capabilities = [
  { title: 'אוטומציות ותהליכי עבודה', label: 'n8n · Make · Webhooks', icon: 'nodes', items: ['תכנון תהליך מקצה לקצה, מבחירת הטריגר ועד למסירת התוצאה', 'שימוש ב־n8n וב־Make, תזמונים יומיים, בדיקות קלט וטיפול בחריגים'] },
  { title: 'CRM ואינטגרציות נתונים', label: 'CRM · REST APIs · Notion', icon: 'database', items: ['חיבור מערכות CRM לטפסים, לידים, קטלוגים ומערכות עסקיות', 'מיפוי שדות, סנכרון נתונים וניהול שלבי מעקב. Notion CRM מוצג בתיק העבודות'] },
  { title: 'אוטומציות שיווק ופרסום', label: 'Social · Campaigns · Reporting', icon: 'message', items: ['חיבור ערוצי סושיאל כגון פייסבוק ואינסטגרם לכלי פרסום, CRM ומודלים חיצוניים', 'הכנת טיוטות, תורי אישור, תזמון משימות ודוחות יומיים'] },
  { title: 'חיבור מודלים וכלי AI', label: 'LLMs · MCP · Tool Calling', icon: 'spark', items: ['שילוב מודלי שפה חיצוניים דרך API לסיווג, סיכום ויצירת תוכן', 'פיתוח כלי MCP, חיבור סוכנים למערכות חיצוניות וניהול הקשר'] },
  { title: 'עיצוב ופיתוח אתרים', label: 'Web Design · Astro · Responsive', icon: 'layout', items: ['עיצוב ובנייה של אתרים, דפי נחיתה וממשקי עבודה מותאמים לנייד', 'חיבור האתר לכלי מדידה, לטפסים ול־CRM לפי הצורך'] },
  { title: 'תשתיות ותוספי דפדפן', label: 'Chrome MV3 · Cloudflare · Supabase', icon: 'browser', items: ['תוספי Chrome לקריאה והזנה של מידע עסקי דרך ממשקי דפדפן', 'Backend, אחסון נתונים, פריסה בענן, אימות והרשאות'] },
] as const;
---
<BaseLayout>
  <SEO slot="head" title={siteConfig.title} noSuffix />
  <section class="hero-band" aria-labelledby="hero-title">
    <div class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker"><span class="status-dot" aria-hidden="true"></span><bdi dir="ltr">Automation & Integrations</bdi></p>
      <h1 id="hero-title">אוטומציות ואתרים<br class="hero-desktop-break" /> עם אינטגרציות<br class="hero-desktop-break" /> <em>מקצה לקצה.</em></h1>
      <p>אני מחבר אתרי אינטרנט, מערכות CRM, ערוצי שיווק ומודלי AI לתהליכים שעובדים יחד. פיתוח ועיצוב לסוכנויות ולצוותי תוכנה, גם כקבלן משנה.</p>
      <div class="actions">
        <a class="button primary" href="#projects">צפייה בפרויקטים <span aria-hidden="true">↓</span></a>
        <a class="button" href="#contact">יצירת קשר לשיתוף פעולה <span class="arrow-diagonal" aria-hidden="true"></span></a>
      </div>
    </div>
    <HeroDiagram />
    </div>
  </section>
  <section id="projects" class="wrap section work-section" aria-labelledby="work-title">
    <div class="section-heading">
      <h2 id="work-title">פרויקטים נבחרים</h2>
      <p>מערכות שבניתי, הבעיות שהן פותרות והבחירות הטכניות שמאחוריהן.</p>
    </div>
    <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
  </section>
  <section id="capabilities" class="capability-band" aria-labelledby="cap-title">
    <div class="wrap section">
      <div class="section-heading">
        <h2 id="cap-title">מה אפשר לבנות יחד</h2>
        <p>משימה ממוקדת או מערכת שמחברת בין כמה צוותים וכלים.</p>
      </div>
      <div class="capability-grid">
        {capabilities.map(({ title, label, icon, items }) => <article>
          <div class="capability-title"><span class="capability-icon"><Glyph name={icon} /></span><h3>{title}</h3></div>
          <p class="capability-label" dir="ltr">{label}</p>
          <ul>{items.map((item) => <li>{item}</li>)}</ul>
        </article>)}
      </div>
    </div>
  </section>
  <WorkflowExample />
  <section id="architecture" class="wrap section ruled" aria-labelledby="architecture-title">
    <div class="section-heading">
      <h2 id="architecture-title">ארכיטקטורה בפועל</h2>
      <p>בחרו מערכת כדי לראות איך מידע ופעולות עוברים בין הרכיבים שלה.</p>
    </div>
    <Architecture projects={projects} id="showcase" />
  </section>
  <section id="collaboration" class="wrap section ruled" aria-labelledby="collab-title">
    <div class="agency">
      <div>
        <p class="eyebrow" dir="ltr">White-label</p>
        <h2 id="collab-title">עבודה עם סוכנויות וצוותי תוכנה</h2>
        <p>אתם מנהלים את הקשר עם לקוח הקצה. אני מבצע את המשימה הטכנית לפי האפיון שלכם, עם בדיקות ותיעוד למסירה. אפשר לעבוד תחת המותג שלכם.</p>
      </div>
      <ol class="agency-steps">
        <li><strong>מגדירים משימה ראשונה</strong><p>מסכימים על התוצאה, המערכות שצריך לחבר וקריטריוני הקבלה.</p></li>
        <li><strong>בונים ובודקים מקצה לקצה</strong><p>אני מחבר את המערכות, בודק תרחישים אמיתיים ומתעד מה מפעיל את התהליך, מה הוא מחזיר ואיך מטפלים בחריגים.</p></li>
        <li><strong>ממשיכים לפי הצורך</strong><p>משימה ראשונה יכולה להפוך לשיתוף פעולה קבוע בפרויקטים נוספים.</p></li>
      </ol>
    </div>
  </section>
  <section id="about" class="wrap section ruled about" aria-labelledby="about-title">
    <h2 id="about-title">קצת עליי</h2>
    <div>
      <p>אני שי הדר, סטודנט להנדסת תעשייה וניהול. אני בונה מערכות וכלי תוכנה שמחברים בין תהליכים עסקיים, נתונים ושירותים חיצוניים.</p>
      <p>בפרויקטים שלי אני מוביל את האפיון, תכנון התהליך, האינטגרציה והבדיקות. אני משתמש בסוכני קוד מבוססי AI כחלק מהמימוש, ובודק בפועל את התוצאה.</p>
      <div class="education">
        <h3>איך לימודי ההנדסה מתחברים לעבודה שלי</h3>
        <ul>
          <li><strong>תכנון וניתוח מערכות מידע</strong> — מיפוי צורכי משתמשים, זרימת נתונים וכללים עסקיים לפני שבונים.</li>
          <li><strong>ניהול טכנולוגיה וחדשנות</strong> — בחירת פתרון לפי הצורך העסקי ויכולת ההטמעה שלו.</li>
          <li><strong>חשבונאות והבנה פיננסית</strong> — חיבור בין עלויות, תמחור ובקרות בתהליכי מסחר.</li>
          <li><strong>מיקרו־כלכלה ומקרו־כלכלה</strong> — הבנת תמריצים, ביקוש ותנאי השוק שבהם עסק פועל.</li>
        </ul>
      </div>
    </div>
  </section>
  <div class="wrap bottom-section"><Contact /></div>
</BaseLayout>
