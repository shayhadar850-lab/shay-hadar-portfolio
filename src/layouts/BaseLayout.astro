---
import '@fontsource-variable/heebo';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import SiteWaveBackground from '../components/SiteWaveBackground.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { he } from '../i18n/he';
---
<!doctype html>
<html lang={he.lang} dir={he.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5f4ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <SiteWaveBackground />
    <span class="scroll-sentinel" data-scroll-sentinel aria-hidden="true"></span>
    <a class="skip-link" href="#main">{he.skip}</a>
    <Navigation />
    <main id="main" class="site-main" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
